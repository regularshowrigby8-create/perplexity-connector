FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NH_DATA_DIR=/data
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libxml2-dev libxslt1-dev curl \
    && rm -rf /var/lib/apt/lists/*
COPY apps/api/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt
COPY apps/api/app ./app

# The launcher ships in the image, so this one container serves the page AND the
# engine on a single origin: GET / is the page, /api/v1/* is the crawler. No
# static host, no proxy rewrite, no "engine offline" banner, nothing local.
COPY index.html ./index.html

# Writable vault (SQLite + Whoosh + Tantivy). Mount a volume here or the index
# is lost when the container is replaced.
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8000
# Listen on $PORT when the host sets one (Render injects PORT and health-checks
# exactly that port; Railway does the same), and on 8000 otherwise (compose, a
# plain docker run, a VPS). Pinning 8000 was why the first Render deploy failed.
HEALTHCHECK --interval=30s --timeout=5s CMD sh -c 'curl -fsS "http://127.0.0.1:${PORT:-8000}/healthz" || exit 1'
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
