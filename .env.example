# GitHub personal access token used SERVER-SIDE by the connector (never committed, never sent to Perplexity).
# Recommended: a fine-grained PAT scoped to the repos you want Perplexity to touch.
# Classic PAT alternative: scope "repo" (all repos) + "read:org" (+ "workflow" if you want Actions access).
GITHUB_TOKEN=

# Optional: if set, MCP clients (Perplexity) must send this as "Authorization: Bearer <key>".
# Perplexity connector form: Authentication → API Key. Generate with: openssl rand -hex(24)
CONNECTOR_API_KEY=

# "true" = only read/search tools are registered (no writes)
GITHUB_READ_ONLY=false

# "true" = additionally register irreversible tools like delete_repository (default: off)
ENABLE_DESTRUCTIVE_TOOLS=false

# For GitHub Enterprise Server / ghe.com, e.g. https://ghe.mycompany.com/api/v3
# GITHUB_API_URL=https://api.github.com

# Local HTTP mode port (MCP_HTTP=1 also enables HTTP mode)
# PORT=3000
