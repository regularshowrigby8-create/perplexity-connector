{
  "name": "perplexity-github-connector",
  "version": "1.0.0",
  "description": "Free self-hosted MCP connector that lets Perplexity read AND write GitHub (code, issues, PRs, branches) directly — no Perplexity API key needed. Deploys free on Vercel.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_HTTP=1 tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
